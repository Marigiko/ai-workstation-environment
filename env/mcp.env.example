# ============================================================================
#  MCP credentials - THE one place to set them.
#
#  Location is not arbitrary: ai-workstation-environment/dotfiles/zsh/.zshrc
#  already sources ~/.config/awe/env/*.env, so this directory is repo-defined.
#  Every MCP wrapper in ~/.local/bin also sources this file directly, because
#  MCP servers are spawned by the client (Claude/mimo/opencode), not by a shell,
#  so shell-only exports would never reach them.
#
#  This file is chmod 600 and is NOT tracked in git. The tracked template is
#  ai-workstation-environment/env/mcp.env.example
#
#  After editing:  no restart needed for new server launches; restart the client.
# ============================================================================

# ---- GitHub -----------------------------------------------------------------
# Not needed: the wrapper pulls a token from `gh auth token` at launch.
# Set this only to override it.
#GITHUB_PERSONAL_ACCESS_TOKEN=

# ---- Upwork (upwork-mcp: browser automation) --------------------------------
# Interactive login, no API keys. Run once:  upwork-mcp --login   (if supported)
#UPWORK_EMAIL=
#UPWORK_PASSWORD=

# ---- FreelanceMCP (needs the most) ------------------------------------------
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Upwork API: https://www.upwork.com/services/api/apply
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
# Freelancer API: https://accounts.freelancer.com/settings/develop
FREELANCER_CLIENT_ID=
FREELANCER_OAUTH_TOKEN=
# Optional notifications
OWNER_COUNTRY_CODE=
OWNER_PHONE_NUMBER=

# ---- LinkedIn (mcp-server-linkedin) -----------------------------------------
# No credentials in this file: it drives a real browser profile.
# Authenticate ONCE, interactively:
#     mcp-server-linkedin --login --no-headless
# Check / clear:
#     mcp-server-linkedin --status
#     mcp-server-linkedin --logout
LINKEDIN_USER_DATA_DIR=
LINKEDIN_HEADLESS=

# ---- n8n-mcp ----------------------------------------------------------------
# Only needed to manage a live n8n instance; documentation tools work without it.
#N8N_API_URL=
#N8N_API_KEY=

# ---- jobspy -----------------------------------------------------------------
# Public job boards; no credentials. Runs in stdio mode.
JOBSPY_ENABLE_SSE=

# ---- ai-workstation gateway postgres ----------------------------------------
# Was hardcoded in components/ai-workstation/install.sh and scripts/start-gateway.sh
AWE_PG_PASSWORD=
