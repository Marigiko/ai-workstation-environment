#!/usr/bin/env bash
# Managed by ai-workstation-environment (mcp/bin). Installed to ~/.local/bin.
# Sources ~/.config/awe/env/mcp.env because MCP servers are spawned by the client,
# not by a shell, so shell exports never reach them.
set -euo pipefail
[ -f "$HOME/.config/awe/env/mcp.env" ] && set -a && . "$HOME/.config/awe/env/mcp.env" && set +a
# Node script with an env-node shebang; a GUI client has neither npx nor node on PATH.
exec "/home/keyz/.nvm/versions/node/v24.18.0/bin/node" "/home/keyz/.nvm/versions/node/v24.18.0/bin/mcp-server-filesystem" "$@"
