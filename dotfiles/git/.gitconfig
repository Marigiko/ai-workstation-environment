[user]
	name = Marigiko
	email = marioaquinojob@gmail.com

[init]
	defaultBranch = main

[core]
	excludesFile = ~/.gitignore_global
	editor = zed --wait

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	lg = log --oneline --graph --all -20
[credential]
	helper = store
